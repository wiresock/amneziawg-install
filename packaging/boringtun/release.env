# Release contract for the public boringtun-cli artifacts. See
# docs/BORINGTUN_ARTIFACTS.md, "Publishing a release".
#
# This file is data, not shell: scripts/boringtun-release.sh parses it with the
# same strict KEY=VALUE grammar as pin.env and never sources it. It names one
# exact release of the pin in pin.env and refuses any disagreement with it: the
# release workflow publishes only archives whose bytes, contents and embedded
# binaries match every hash below, from a successful, attested run of the
# BoringTun Artifacts workflow.
#
# BORINGTUN_RELEASE_STATE is `candidate` until the maintainers approve this
# exact release; the workflow never publishes a candidate. A candidate can be
# checked end to end with the workflow's dry-run mode.
#
# BORINGTUN_RELEASE_BUILD counts builds of one source commit: it goes up with
# every change of toolchain, build flags, packaging or notices that changes the
# archive bytes. A published tag is never reused or moved, so once a build is
# public, different bytes need a new build number.
#
# Current candidate: build 1 of the source checkpoint ae2ab44e9a68 (tree
# 3bea8cdeefd5f55a1129db7d31481b9b3a8edde8, upstream tag
# awg3.1-integration-2026-10-02), as BoringTun Artifacts run 37055636398
# (branch build/boringtun-ae2ab44-artifact, commit 77f0c55bacb70eea879497ed53eeec920231cf8f)
# built it; the x86_64 build was also reproduced byte for byte on another
# machine. The published release of the previous pin,
# boringtun-cli-0.7.1-g71d88784ad29-b1, is untouched. The build number starts
# again at 1 because it counts builds of one source commit.
BORINGTUN_RELEASE_FORMAT=1
BORINGTUN_RELEASE_STATE=candidate
BORINGTUN_RELEASE_SOURCE_COMMIT=ae2ab44e9a68ca1a3232d2e8b13f9db30a9b9dcf
BORINGTUN_RELEASE_VERSION=0.7.1
BORINGTUN_RELEASE_ARTIFACT_FORMAT=1
BORINGTUN_RELEASE_BUILD=1
BORINGTUN_RELEASE_TAG=boringtun-cli-0.7.1-gae2ab44e9a68-b1
BORINGTUN_RELEASE_ASSET_X86_64=boringtun-cli-0.7.1-gae2ab44e9a68-linux-x86_64-musl.tar.gz
BORINGTUN_RELEASE_ARCHIVE_SHA256_X86_64=d509a73ef26b9b560e2b836709f0ab4332edde06f12d77a03a1ac31fe4d3a221
BORINGTUN_RELEASE_BINARY_SHA256_X86_64=ad23145661408732b9e04b6edad6730134ef5fa06637f50892d1e46d523970e7
BORINGTUN_RELEASE_ASSET_AARCH64=boringtun-cli-0.7.1-gae2ab44e9a68-linux-aarch64-musl.tar.gz
BORINGTUN_RELEASE_ARCHIVE_SHA256_AARCH64=865e9aebcb6d3a28f4618f98e14fa667ecc7ceb47440f3a5e96be8e7ded9f50b
BORINGTUN_RELEASE_BINARY_SHA256_AARCH64=32239dd79858f58a8cad1e3782c7867dc9d71c6ebe098410d184367eef95cf21

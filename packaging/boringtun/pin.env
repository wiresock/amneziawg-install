# Pinned WireSock BoringTun source for the boringtun-cli artifacts built by
# .github/workflows/boringtun-artifacts.yml. See docs/BORINGTUN_ARTIFACTS.md.
#
# This file is data, not shell. scripts/boringtun-artifact.sh parses it with a
# strict KEY=VALUE grammar and never sources or executes it. It is the only
# place in this repository that defines these values: change them together, in
# a reviewed pin-bump change, and never use a branch or tag name as the commit.
BORINGTUN_REPOSITORY=https://github.com/Wiresock-Foundation/wiresock-boringtun
BORINGTUN_COMMIT=e4e4dc85ec039d40bbc92b3667b7fc92966b1b0a
BORINGTUN_VERSION=0.7.1
BORINGTUN_RUST_TOOLCHAIN=1.98.1
BORINGTUN_ARTIFACT_FORMAT=1
